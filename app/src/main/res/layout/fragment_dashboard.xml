<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Compose box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_compose_box"
            android:padding="14dp"
            android:layout_margin="16dp">

            <EditText
                android:id="@+id/etComposeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/bg_compose_textarea"
                android:padding="11dp"
                android:hint="Write something for your organizations..."
                android:textColorHint="@color/placeholder_gray"
                android:textColor="@color/dark_blue"
                android:textSize="12.5sp"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="11dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_audience_toggle_group"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/toggleEveryone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_audience_toggle_active"
                        android:paddingHorizontal="11dp"
                        android:paddingVertical="7dp"
                        android:text="Everyone"
                        android:textColor="@color/white"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/toggleAdminsOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="11dp"
                        android:paddingVertical="7dp"
                        android:text="Admins Only"
                        android:textColor="@color/text_gray"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnSubmitPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_post_submit_btn"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:text="Post"
                    android:textColor="@color/white"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="10dp"
            android:text="Recent Posts"
            android:textColor="@color/dark_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_feed_text_post"
            xmlns:tools="http://schemas.android.com/tools" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>