<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_header_gradient_admin">


    <!-- ===================================================== -->
    <!-- ADMIN HEADER                                          -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="101dp"
        android:background="@drawable/bg_header_gradient_admin"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_org_badge"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tvOrgInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="WN"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="BBCO · BISU Balilihan"
                    android:textColor="#DDF6F3"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOrgName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Campus Organization"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnChat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_header_icon_btn"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat_message"
                    android:contentDescription="Group chat"
                    app:tint="@color/white" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- LIGHT CURVED MAIN AREA                                -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/mainContentSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_header_curve_admin"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="14dp"
            android:paddingBottom="88dp"
            tools:layout="@layout/fragment_admin_dashboard" />

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- FAB                                                   -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_fab"
        android:padding="15dp"
        android:src="@drawable/ic_add"
        android:elevation="12dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/add_folder"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- FLOATING BOTTOM NAV                                   -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/customBottomNav"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:layout_marginBottom="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <View
            android:id="@+id/navBarSurface"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_glass_bottom_nav"
            android:elevation="3dp" />


        <LinearLayout
            android:id="@+id/navItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="12dp"
            android:orientation="horizontal">


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_dashboard"
                    android:contentDescription="@string/nav_home"
                    app:tint="@color/admin_end" />

                <TextView
                    android:id="@+id/labelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-5dp"
                    android:text="Home"
                    android:textColor="@color/admin_end"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/underlineHome"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>


            <!-- MEMBERS -->

            <LinearLayout
                android:id="@+id/navMembers"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconMembers"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_members"
                    android:contentDescription="@string/nav_members"
                    app:tint="#AAB7C8" />

                <TextView
                    android:id="@+id/labelMembers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-5dp"
                    android:text="Members"
                    android:textColor="#AAB7C8"
                    android:textSize="8sp" />

                <View
                    android:id="@+id/underlineMembers"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>


            <!-- NOTIFICATIONS -->

            <LinearLayout
                android:id="@+id/navNotifications"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="@string/nav_notifications"
                    app:tint="#AAB7C8" />

                <TextView
                    android:id="@+id/labelNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-5dp"
                    android:text="Notifications"
                    android:textColor="#AAB7C8"
                    android:textSize="7sp" />

                <View
                    android:id="@+id/underlineNotifications"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>


            <!-- REQUIREMENTS -->

            <LinearLayout
                android:id="@+id/navRequirements"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconRequirements"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_documents"
                    android:contentDescription="@string/nav_requirements"
                    app:tint="#AAB7C8" />

                <TextView
                    android:id="@+id/labelRequirements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-5dp"
                    android:text="Requirements"
                    android:textColor="#AAB7C8"
                    android:textSize="7sp" />

                <View
                    android:id="@+id/underlineRequirements"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>


            <!-- PROFILE -->

            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_profile_person"
                    android:contentDescription="@string/nav_profile"
                    app:tint="#AAB7C8" />

                <TextView
                    android:id="@+id/labelProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-5dp"
                    android:text="Profile"
                    android:textColor="#AAB7C8"
                    android:textSize="8sp" />

                <View
                    android:id="@+id/underlineProfile"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="invisible" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>