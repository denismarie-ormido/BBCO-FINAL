<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient_admin"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_org_badge">

                    <TextView
                        android:id="@+id/tvOrgInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="RCY"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADVISER · BBCO"
                        android:textColor="#CFE6FF"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tvOrgName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Red Cross Youth"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnProfile"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_header_icon_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile_person"
                    app:tint="@color/white"
                    android:contentDescription="@string/profile" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_org_badge"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="ORGANIZATION ADVISER"
            android:textColor="@color/white"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Good day, Ma'am Reyes"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tuesday, Aug 29 · Red Cross Youth Overview"
            android:textColor="#CADAFA"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- FRAGMENT AREA -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_light"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FAB -->
    <ImageView
        android:id="@+id/fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_fab"
        android:padding="15dp"
        android:src="@drawable/ic_add"
        android:elevation="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/add_folder"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/customBottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_dashboard"
                app:tint="@color/navy"
                android:contentDescription="@string/nav_home" />

            <View
                android:id="@+id/underlineHome"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMembers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconMembers"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_members"
                app:tint="@color/placeholder_gray"
                android:contentDescription="@string/nav_members" />

            <View
                android:id="@+id/underlineMembers"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconNotifications"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/placeholder_gray"
                android:contentDescription="@string/nav_notifications" />

            <View
                android:id="@+id/underlineNotifications"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRequirements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconRequirements"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_documents"
                app:tint="@color/placeholder_gray"
                android:contentDescription="@string/nav_requirements" />

            <View
                android:id="@+id/underlineRequirements"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person"
                app:tint="@color/placeholder_gray"
                android:contentDescription="@string/nav_profile" />

            <View
                android:id="@+id/underlineProfile"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>