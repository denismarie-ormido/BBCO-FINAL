<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- BOTTOM SHEET HANDLE -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center"
        android:background="#FFFFFF">

        <View
            android:layout_width="45dp"
            android:layout_height="5dp"
            android:background="#E3EAF2" />

    </LinearLayout>

    <!-- SCROLLABLE BOTTOM SHEET -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <!-- TITLE AND CLOSE BUTTON -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Find My Organization"
                    android:textColor="#153667"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/smartmatchBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="×"
                    android:textSize="27sp"
                    android:textColor="#627789"
                    android:background="#F1F5F8"
                    android:contentDescription="Close"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- DESCRIPTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Discover campus organizations that match your interests, skills, and goals."
                android:textColor="#8491A0"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <!-- INTERESTS LABEL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="13dp"
                android:text="SELECT YOUR INTERESTS"
                android:textColor="#78909E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- INTEREST OPTIONS -->

            <LinearLayout
                android:id="@+id/smartmatchInterestContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ADDITIONAL INTEREST -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="OTHER INTERESTS (OPTIONAL)"
                android:textColor="#78909E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/smartmatchOtherInterest"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="#F8FBFF"
                android:gravity="top"
                android:padding="14dp"
                android:hint="Tell us what you enjoy doing..."
                android:textColor="#234E65"
                android:textColorHint="#99A8B6"
                android:textSize="13sp"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="100" />

            <!-- FIND MATCH BUTTON -->

            <TextView
                android:id="@+id/smartmatchFindButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:background="#0DAEA5"
                android:text="✦  Find My Match"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- LOADING INDICATOR -->

            <ProgressBar
                android:id="@+id/smartmatchProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- AI RECOMMENDATIONS -->

            <TextView
                android:id="@+id/smartmatchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="Select your interests to get started."
                android:textColor="#64798C"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/smartmatchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
