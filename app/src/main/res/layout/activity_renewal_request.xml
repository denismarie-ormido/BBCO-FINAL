<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF7FC">


    <!-- ========================================================= -->
    <!-- ADMIN STYLE HEADER                                        -->
    <!-- ========================================================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@drawable/bg_header_gradient_admin">


        <!-- subtle decoration -->

        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-45dp"
            android:layout_marginEnd="-28dp"
            android:alpha="0.12"
            android:background="@drawable/bg_auth_deco_circle" />


        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-25dp"
            android:layout_marginBottom="-20dp"
            android:alpha="0.10"
            android:background="@drawable/bg_auth_deco_circle" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">


            <!-- BACK -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#22FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#42FFFFFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/white" />

            </com.google.android.material.card.MaterialCardView>


            <!-- TITLE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="ORGANIZATION ADMIN"
                    android:textColor="#DFF7FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="Renewal Request"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>


    <!-- ========================================================= -->
    <!-- CONTENT                                                   -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">


            <!-- ===================================================== -->
            <!-- ORGANIZATION CARD                                     -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F9FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:strokeColor="#D9EDF5"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="17dp">


                    <!-- INITIAL / BADGE -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="#DDF5FB"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="ORG"
                            android:textColor="@color/admin_end"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.08"
                            android:text="ORGANIZATION"
                            android:textColor="#6E8091"
                            android:textSize="8.5sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tvOrganizationName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Organization Name"
                            android:textColor="#123B5A"
                            android:textSize="17sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tvOrganizationCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="ORG"
                            android:textColor="@color/admin_end"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- ACADEMIC YEAR                                        -->
            <!-- ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">


                <!-- CURRENT -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F6FCFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#CDECF7"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="CURRENT"
                            android:textColor="#718898"
                            android:textSize="8sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tvCurrentAcademicYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="2026-2027"
                            android:textColor="#123B5A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- RENEWING -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#EAF9FD"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#BFE7F1"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="RENEWING"
                            android:textColor="#718898"
                            android:textSize="8sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/tvRenewingAcademicYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="2027-2028"
                            android:textColor="@color/admin_end"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ===================================================== -->
            <!-- REQUIREMENTS TITLE                                   -->
            <!-- ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Renewal Requirements"
                    android:textColor="#123B5A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Upload all required documents before submitting your renewal request."
                    android:textColor="#718898"
                    android:textSize="10.5sp" />

            </LinearLayout>


            <!-- ===================================================== -->
            <!-- REQUIREMENT 1                                        -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#DDECF2"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="10dp"
                        android:text="Student Organization Accreditation Form"
                        android:textColor="#173F5F"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:maxLines="2" />


                    <Button
                        android:id="@+id/btnUpload1"
                        android:layout_width="84dp"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="UPLOAD"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/admin_end"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- REQUIREMENT 2                                        -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#DDECF2"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="10dp"
                        android:text="Accomplishment Report"
                        android:textColor="#173F5F"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />


                    <Button
                        android:id="@+id/btnUpload2"
                        android:layout_width="84dp"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="UPLOAD"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/admin_end"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- REQUIREMENT 3                                        -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#DDECF2"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="10dp"
                        android:maxLines="2"
                        android:text="Copy of Constitutional and By Laws"
                        android:textColor="#173F5F"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />


                    <Button
                        android:id="@+id/btnUpload3"
                        android:layout_width="84dp"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="UPLOAD"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/admin_end"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- REQUIREMENT 4                                        -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#DDECF2"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="10dp"
                        android:text="Updated List of Members"
                        android:textColor="#173F5F"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />


                    <Button
                        android:id="@+id/btnUpload4"
                        android:layout_width="84dp"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="UPLOAD"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/admin_end"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- REQUIREMENT 5                                        -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#DDECF2"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="10dp"
                        android:maxLines="2"
                        android:text="Annual Work Plan of Activities"
                        android:textColor="#173F5F"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />


                    <Button
                        android:id="@+id/btnUpload5"
                        android:layout_width="84dp"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="UPLOAD"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/admin_end"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- REQUIREMENT 6                                        -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#DDECF2"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="10dp"
                        android:text="Financial Statement"
                        android:textColor="#173F5F"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />


                    <Button
                        android:id="@+id/btnUpload6"
                        android:layout_width="84dp"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="UPLOAD"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/admin_end"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ===================================================== -->
            <!-- STATUS                                               -->
            <!-- ===================================================== -->

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#E5F7FC"
                android:paddingStart="13dp"
                android:paddingTop="11dp"
                android:paddingEnd="13dp"
                android:paddingBottom="11dp"
                android:text=""
                android:textColor="@color/admin_end"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />


            <!-- ===================================================== -->
            <!-- SUBMIT                                               -->
            <!-- ===================================================== -->

            <Button
                android:id="@+id/btnSubmitRenewal"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:minHeight="0dp"
                android:text="UPLOAD ALL REQUIREMENTS"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="@color/admin_end"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:enabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>