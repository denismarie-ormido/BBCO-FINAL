<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#DFFFFFFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeColor="#ECF2FB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp">


        <!-- ===================================================== -->
        <!-- POST HEADER                                           -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">


            <!-- PROFILE AVATAR -->

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp">

                <TextView
                    android:id="@+id/tvPosterAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="ORG"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgPosterAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Organization profile picture"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </FrameLayout>


            <!-- NAME + TIME -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPosterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organization"
                    android:textColor="#0B2E6B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Just now"
                    android:textColor="#7C8CA5"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- POST MENU -->

            <ImageView
                android:id="@+id/btnPostMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:contentDescription="Post menu"
                android:focusable="true"
                android:padding="3dp"
                android:src="@drawable/ic_more_vert"
                app:tint="#7890AF" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- AUDIENCE                                              -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvAudienceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="EVERYONE"
            android:textColor="#52627A"
            android:textSize="9sp"
            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- POST TEXT                                             -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="5"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Post content"
            android:textColor="#0B2E6B"
            android:textSize="14sp" />


        <!-- SEE MORE / SEE LESS -->

        <TextView
            android:id="@+id/tvSeeMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="13dp"
            android:clickable="true"
            android:focusable="true"
            android:text="See more"
            android:textColor="#2196D3"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAF0F8" />


        <!-- ===================================================== -->
        <!-- ACTIONS                                               -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">


            <!-- LIKE -->

            <LinearLayout
                android:id="@+id/btnLike"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgHeart"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Like"
                    android:src="@drawable/ic_heart"
                    app:tint="#173F7A" />

                <TextView
                    android:id="@+id/tvLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="0"
                    android:textColor="#0B2E6B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- COMMENT -->

            <LinearLayout
                android:id="@+id/btnComment"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Comment"
                    android:src="@drawable/ic_comment"
                    app:tint="#173F7A" />

                <TextView
                    android:id="@+id/tvCommentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="0"
                    android:textColor="#0B2E6B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- SHARE -->

            <LinearLayout
                android:id="@+id/btnShare"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgShare"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Share"
                    android:src="@drawable/ic_share"
                    app:tint="#173F7A" />

                <TextView
                    android:id="@+id/tvShareCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="0"
                    android:textColor="#0B2E6B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>