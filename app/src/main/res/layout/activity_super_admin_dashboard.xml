<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- ========================================================= -->
    <!-- SUPER ADMIN HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ===================================================== -->
        <!-- TOP BRAND ROW -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Crown / Super Admin Logo -->

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_org_badge">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_crown"
                    app:tint="#FFC773"
                    android:contentDescription="@null" />

            </FrameLayout>

            <!-- BBCO Text -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BBCo · BISU Balilihan"
                    android:textColor="#D2E2FF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus Organization"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Profile Button -->

            <FrameLayout
                android:id="@+id/btnProfile"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_header_icon_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile_person"
                    app:tint="@color/white"
                    android:contentDescription="@string/profile" />

            </FrameLayout>

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- ROLE -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_role_pill"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="13dp">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_crown"
                app:tint="#FFE8B8"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvRoleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="SUPER ADMIN"
                android:textColor="#FFE8B8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- GREETING -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Good day, Super Admin"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Campus Organization Overview"
            android:textColor="#D0DFFF"
            android:textSize="12.5sp" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- CONTENT / FRAGMENTS -->
    <!-- ========================================================= -->

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_light"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- FLOATING ACTION BUTTON -->
    <!-- ========================================================= -->

    <ImageView
        android:id="@+id/fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_fab"
        android:padding="16dp"
        android:src="@drawable/ic_add"
        android:elevation="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@id/customBottomNav"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- CUSTOM BOTTOM NAVIGATION -->
    <!-- SAME STYLE AS ADMIN / STUDENT -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/customBottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white"
        android:paddingTop="11dp"
        android:paddingBottom="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ===================================================== -->
        <!-- HOME -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_dashboard"
                app:tint="#173F7A"
                android:contentDescription="@string/nav_home" />

            <View
                android:id="@+id/underlineHome"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="visible" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ORGANIZATIONS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/navOrganizations"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconOrganizations"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_orgs"
                app:tint="#AAB7C8"
                android:contentDescription="@string/nav_organizations" />

            <View
                android:id="@+id/underlineOrganizations"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="invisible" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- NOTIFICATIONS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconNotifications"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bell"
                app:tint="#AAB7C8"
                android:contentDescription="@string/nav_notifications" />

            <View
                android:id="@+id/underlineNotifications"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="invisible" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- DOCUMENTS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/navDocuments"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconDocuments"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_documents"
                app:tint="#AAB7C8"
                android:contentDescription="@string/nav_documents" />

            <View
                android:id="@+id/underlineDocuments"
                android:layout_width="18dp"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_nav_underline"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>