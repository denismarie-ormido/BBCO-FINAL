<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/signUpScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ================================================= -->
            <!-- MODERN HEADER -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/headerCurve"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:background="@drawable/bg_header_curve_student"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Back Button -->

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_back_circle"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/white"
                    android:contentDescription="@string/back"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Header Icon -->

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_header_icon_circle">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_grad_cap"
                        app:tint="@color/white"
                        android:contentDescription="@null" />

                </FrameLayout>

                <!-- Header Text -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="112dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BBCO"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Student Registration"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:alpha="0.9" />

                </LinearLayout>

            </FrameLayout>


            <!-- ================================================= -->
            <!-- CONTENT -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/contentLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="22dp"
                android:paddingBottom="36dp"
                app:layout_constraintTop_toBottomOf="@id/headerCurve"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">


                <!-- TITLE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create your account"
                    android:textColor="@color/dark_blue"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Join the BISU Balilihan Campus Organization"
                    android:textColor="@color/text_gray"
                    android:textSize="12.5sp" />


                <!-- ================================================= -->
                <!-- PERSONAL INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="PERSONAL INFORMATION"
                    android:textColor="@color/dark_blue"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />


                <!-- FULL NAME -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/placeholder_gray"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Full Name"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="textPersonName"
                        android:autofillHints="name" />

                </LinearLayout>


                <!-- STUDENT ID -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_id_card"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etStudentId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Student ID Number"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="text" />

                </LinearLayout>


                <!-- COURSE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_school"
                        android:contentDescription="@null" />

                    <Spinner
                        android:id="@+id/spinnerCourse"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:entries="@array/course_list"
                        android:spinnerMode="dropdown"
                        android:popupBackground="@color/white" />

                </LinearLayout>


                <!-- YEAR LEVEL -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_calendar"
                        android:contentDescription="@null" />

                    <Spinner
                        android:id="@+id/spinnerYearLevel"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:entries="@array/year_level_list"
                        android:spinnerMode="dropdown"
                        android:popupBackground="@color/white" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- ACCOUNT INFORMATION -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="ACCOUNT INFORMATION"
                    android:textColor="@color/dark_blue"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />


                <!-- EMAIL -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_mail"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="BISU Email (name@bisu.edu.ph)"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13sp"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress" />

                </LinearLayout>


                <!-- USERNAME -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/placeholder_gray"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Username"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="text"
                        android:autofillHints="username" />

                </LinearLayout>


                <!-- PASSWORD -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Password"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="textPassword"
                        android:autofillHints="password" />

                    <ImageView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:padding="1dp"
                        android:src="@drawable/ic_eye"
                        android:contentDescription="@string/toggle_password"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>


                <!-- CONFIRM PASSWORD -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Confirm Password"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="textPassword"
                        android:autofillHints="password" />

                    <ImageView
                        android:id="@+id/btnToggleConfirmPassword"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:padding="1dp"
                        android:src="@drawable/ic_eye"
                        android:contentDescription="@string/toggle_password"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- INTEREST -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="ABOUT YOU"
                    android:textColor="@color/dark_blue"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_pill_input_teal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:minHeight="54dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_interest"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etInterest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Your interests (e.g. volunteering, tech, sports)"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13sp"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="1"
                        android:maxLines="3"
                        android:gravity="top" />

                </LinearLayout>


                <!-- ERROR -->

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textColor="#E53935"
                    android:textSize="12sp"
                    android:visibility="gone" />


                <!-- ================================================= -->
                <!-- SIGN UP BUTTON -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/btnSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_btn_teal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CREATE ACCOUNT"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                </LinearLayout>


                <!-- LOGIN -->

                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_gravity="center_horizontal"
                    android:text="Already have an account?  Login"
                    android:textColor="@color/text_gray"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>