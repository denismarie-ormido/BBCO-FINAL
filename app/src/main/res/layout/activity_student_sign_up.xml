<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF9F8">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/signUpScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <FrameLayout
                android:id="@+id/headerCurve"
                android:layout_width="match_parent"
                android:layout_height="275dp"
                android:background="@drawable/bg_v2_header_student"
                android:clipChildren="true">

                <View
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-50dp"
                    android:layout_marginEnd="-40dp"
                    android:background="@drawable/bg_v2_deco_circle" />

                <View
                    android:layout_width="95dp"
                    android:layout_height="95dp"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="-30dp"
                    android:layout_marginBottom="50dp"
                    android:background="@drawable/bg_v2_deco_circle" />

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_header_icon_btn"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:padding="11dp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="#2A9D95" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="56dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@drawable/bg_auth_deco_circle"
                        android:elevation="6dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_grad_cap"
                            app:tint="#2A9D95" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:letterSpacing="0.2"
                        android:text="BBCO"
                        android:textColor="#F0FFFD"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Student Registration"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- FORM CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="18dp" android:layout_marginTop="-70dp" android:layout_marginEnd="18dp"
                app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="28dp" app:cardElevation="8dp">

                <LinearLayout
                    android:id="@+id/contentLayout"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp" android:paddingTop="24dp"
                    android:paddingEnd="20dp" android:paddingBottom="26dp">

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Create your account" android:textColor="#17413F"
                        android:textSize="22sp" android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Join the BISU Balilihan Campus Organization"
                        android:textColor="#6F8E8B" android:textSize="12.5sp" />

                    <!-- PERSONAL INFORMATION -->
                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="22dp" android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="14dp"
                            android:background="@drawable/bg_v2_accent_teal" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:letterSpacing="0.08"
                            android:text="PERSONAL INFORMATION" android:textColor="#2A9D95"
                            android:textSize="10.5sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Full name -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="12dp" android:background="@drawable/bg_v2_input_teal"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingEnd="14dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_person" app:tint="#2A9D95" />
                        </FrameLayout>
                        <EditText
                            android:id="@+id/etFullName"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:layout_weight="1"
                            android:autofillHints="name" android:background="@null"
                            android:hint="Full Name" android:inputType="textPersonName"
                            android:textColor="#17413F" android:textColorHint="#7FA9A5" android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Student ID -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="11dp" android:background="@drawable/bg_v2_input_teal"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingEnd="14dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_id_card" app:tint="#2A9D95" />
                        </FrameLayout>
                        <EditText
                            android:id="@+id/etStudentId"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:layout_weight="1"
                            android:background="@null" android:hint="Student ID Number"
                            android:inputType="text"
                            android:textColor="#17413F" android:textColorHint="#7FA9A5" android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Course -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="11dp" android:background="@drawable/bg_v2_input_teal"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingEnd="6dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_school" app:tint="#2A9D95" />
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_marginStart="6dp" android:layout_weight="1">
                            <Spinner
                                android:id="@+id/spinnerCourse"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@null" android:entries="@array/course_list"
                                android:popupBackground="@color/white" android:spinnerMode="dropdown" />
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp"
                                android:text="▾" android:textColor="#2A9D95" android:textSize="16sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Year level -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="11dp" android:background="@drawable/bg_v2_input_teal"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingEnd="6dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_calendar" app:tint="#2A9D95" />
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_marginStart="6dp" android:layout_weight="1">
                            <Spinner
                                android:id="@+id/spinnerYearLevel"
                                android:layout_width="match_parent" android:layout_height="match_parent"
                                android:background="@null" android:entries="@array/year_level_list"
                                android:popupBackground="@color/white" android:spinnerMode="dropdown" />
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp"
                                android:text="▾" android:textColor="#2A9D95" android:textSize="16sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- ACCOUNT INFORMATION -->
                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="26dp" android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="14dp"
                            android:background="@drawable/bg_v2_accent_teal" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:letterSpacing="0.08"
                            android:text="ACCOUNT INFORMATION" android:textColor="#2A9D95"
                            android:textSize="10.5sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="12dp" android:background="@drawable/bg_v2_input_teal"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingEnd="14dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_mail" app:tint="#2A9D95" />
                        </FrameLayout>
                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:layout_weight="1"
                            android:autofillHints="emailAddress" android:background="@null"
                            android:hint="BISU Email (bal_@bisu.edu.ph)" android:inputType="textEmailAddress"
                            android:textColor="#17413F" android:textColorHint="#7FA9A5" android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- Username -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="11dp" android:background="@drawable/bg_v2_input_teal"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingEnd="14dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_person" app:tint="#2A9D95" />
                        </FrameLayout>
                        <EditText
                            android:id="@+id/etUsername"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:layout_weight="1"
                            android:autofillHints="username" android:background="@null"
                            android:hint="Username" android:inputType="text"
                            android:textColor="#17413F" android:textColorHint="#7FA9A5" android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Password -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="11dp" android:background="@drawable/bg_v2_input_teal"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingEnd="6dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_lock" app:tint="#2A9D95" />
                        </FrameLayout>
                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:layout_weight="1"
                            android:autofillHints="password" android:background="@null"
                            android:hint="Password" android:inputType="textPassword"
                            android:textColor="#17413F" android:textColorHint="#7FA9A5" android:textSize="14sp" />
                        <ImageView
                            android:id="@+id/btnTogglePassword"
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true" android:focusable="true" android:padding="10dp"
                            android:contentDescription="@string/toggle_password"
                            android:src="@drawable/ic_eye" app:tint="#2A9D95" />
                    </LinearLayout>

                    <!-- Confirm password -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="11dp" android:background="@drawable/bg_v2_input_teal"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingEnd="6dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_lock" app:tint="#2A9D95" />
                        </FrameLayout>
                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:layout_weight="1"
                            android:autofillHints="password" android:background="@null"
                            android:hint="Confirm Password" android:inputType="textPassword"
                            android:textColor="#17413F" android:textColorHint="#7FA9A5" android:textSize="14sp" />
                        <ImageView
                            android:id="@+id/btnToggleConfirmPassword"
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true" android:focusable="true" android:padding="10dp"
                            android:contentDescription="@string/toggle_password"
                            android:src="@drawable/ic_eye" app:tint="#2A9D95" />
                    </LinearLayout>

                    <!-- ABOUT YOU -->
                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="26dp" android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View android:layout_width="4dp" android:layout_height="14dp"
                            android:background="@drawable/bg_v2_accent_teal" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:letterSpacing="0.08"
                            android:text="ABOUT YOU" android:textColor="#2A9D95"
                            android:textSize="10.5sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:background="@drawable/bg_v2_input_teal"
                        android:minHeight="56dp" android:orientation="horizontal"
                        android:paddingStart="11dp" android:paddingTop="11dp"
                        android:paddingEnd="14dp" android:paddingBottom="11dp">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
                            android:background="@drawable/bg_v2_icon_teal">
                            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_interest" app:tint="#2A9D95" />
                        </FrameLayout>
                        <EditText
                            android:id="@+id/etInterest"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:layout_marginTop="6dp"
                            android:layout_weight="1" android:background="@null" android:gravity="top"
                            android:hint="Your interests (e.g. volunteering, tech, sports)"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="3" android:minLines="1"
                            android:textColor="#17413F" android:textColorHint="#7FA9A5" android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- Error -->
                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:background="@drawable/bg_reject_btn"
                        android:padding="11dp" android:text="" android:textColor="#C62828"
                        android:textSize="12sp" android:visibility="gone" />

                    <!-- Sign up button -->
                    <LinearLayout
                        android:id="@+id/btnSignUp"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:layout_marginTop="22dp" android:background="@drawable/bg_v2_btn_teal"
                        android:clickable="true" android:focusable="true" android:elevation="4dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center" android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:letterSpacing="0.08" android:text="CREATE ACCOUNT"
                            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="→"
                            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Login link -->
                    <TextView
                        android:id="@+id/tvGoToLogin"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:gravity="center"
                        android:padding="10dp" android:text="Already have an account?  Login"
                        android:textColor="#2A9D95" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View android:layout_width="match_parent" android:layout_height="28dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>