<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===================== COVER PHOTO ===================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_cover_placeholder">

            <ImageView
                android:id="@+id/imgCoverPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cover_photo_desc" />

            <!-- Reused: bg_header_icon_btn + ic_photo -->
            <FrameLayout
                android:id="@+id/btnChangeCover"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_header_icon_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_photo"
                    app:tint="@color/white"
                    android:contentDescription="@string/change_cover" />
            </FrameLayout>
        </FrameLayout>

        <!-- ===================== AVATAR (overlaps cover) ===================== -->
        <!-- ===================== AVATAR (overlaps cover) ===================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-40dp"
            android:paddingStart="18dp">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_avatar_frame_white"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/avatarClickArea">

                <TextView
                    android:id="@+id/tvOrgAvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_org_avatar_large"
                    android:gravity="center"
                    android:text="RCY"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgOrgAvatarPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_org_avatar_large"
                    android:outlineProvider="background"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@string/org_logo" />

                <FrameLayout
                    android:id="@+id/btnChangeAvatar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_camera_overlay"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_photo"
                        app:tint="@color/white"
                        android:contentDescription="@string/org_logo" />
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- ===================== ORG INFO ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOrgName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Red Cross Youth"
                        android:textColor="@color/dark_blue"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrgCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Student Organization"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Edit Profile button -->
                <LinearLayout
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/blue_deep"
                        android:contentDescription="@string/edit_profile" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Edit"
                        android:textColor="@color/blue_deep"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvOrgDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Promoting volunteerism, leadership, community service, and youth development."
                android:textColor="@color/dark_blue"
                android:textSize="12.5sp"
                android:lineSpacingExtra="2dp" />

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatMembers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="34"
                        android:textColor="@color/dark_blue"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Members"
                        android:textColor="@color/text_gray"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stat_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatPosts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textColor="@color/dark_blue"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Posts"
                        android:textColor="@color/text_gray"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_stat_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textColor="@color/dark_blue"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Events"
                        android:textColor="@color/text_gray"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tabs: Posts / About / Members -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:id="@+id/tabPosts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="9dp"
                        android:text="Posts"
                        android:textColor="@color/dark_blue"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/underlinePosts"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@drawable/bg_tab_underline_active" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabAbout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="9dp"
                        android:text="About"
                        android:textColor="@color/text_gray"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/underlineAbout"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/card_border" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabMembers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="9dp"
                        android:text="Members"
                        android:textColor="@color/text_gray"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/underlineMembers"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/card_border" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== TAB CONTENT: POSTS ===================== -->
        <LinearLayout
            android:id="@+id/contentPosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_create_post_box"
                android:padding="14dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create a post"
                    android:textColor="@color/dark_blue"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etOrgProfileCompose"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_create_post_input"
                    android:paddingHorizontal="16dp"
                    android:hint="What's happening in your organization?"
                    android:textColorHint="@color/placeholder_gray"
                    android:textColor="@color/dark_blue"
                    android:textSize="12.5sp"
                    android:inputType="text" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrgProfileFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="20dp"
                tools:listitem="@layout/item_feed_text_post"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <!-- ===================== TAB CONTENT: ABOUT ===================== -->
        <LinearLayout
            android:id="@+id/contentAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCRIPTION"
                    android:textColor="@color/text_gray"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvAboutDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="Promoting volunteerism, leadership, community service, and youth development among BISU Balilihan students."
                    android:textColor="@color/dark_blue"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADVISER"
                    android:textColor="@color/text_gray"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvAboutAdviser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="Ma'am Reyes"
                    android:textColor="@color/dark_blue"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOUNDED"
                    android:textColor="@color/text_gray"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvAboutFounded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="2017"
                    android:textColor="@color/dark_blue"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== TAB CONTENT: MEMBERS ===================== -->
        <LinearLayout
            android:id="@+id/contentMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingBottom="30dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrgProfileMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_member"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>