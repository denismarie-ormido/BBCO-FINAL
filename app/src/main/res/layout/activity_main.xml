<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <!-- ===================================================== -->
    <!-- BACKGROUND                                            -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_main_bbco"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- RESPONSIVE CONTENT                                    -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">


            <!-- ================================================= -->
            <!-- LOGO                                              -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp">


                <View
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_logo_circle" />


                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bbco_logo2"
                    android:scaleType="fitCenter"
                    android:contentDescription="BBCO Logo" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- BBCO TITLE                                        -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="BBCO"
                android:textColor="@color/dark_blue"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />


            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="BISU Balilihan Campus Organization"
                android:textColor="@color/text_gray"
                android:textSize="11.5sp" />


            <!-- DECORATIVE LINE -->

            <View
                android:layout_width="38dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_small_line" />


            <!-- ================================================= -->
            <!-- WELCOME                                           -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Welcome!"
                android:textColor="@color/dark_blue"
                android:textSize="26sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvSelectRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Please select your role to continue"
                android:textColor="@color/text_gray"
                android:textSize="11.5sp" />


            <!-- ================================================= -->
            <!-- SUPER ADMIN                                       -->
            <!-- ID PRESERVED                                      -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/btnSuperAdmin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_super_admin2"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="13dp">


                <!-- ICON CIRCLE -->

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_role_icon_circle">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_crown"
                        android:contentDescription="@null" />

                </FrameLayout>


                <!-- TEXT -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="SUPER ADMIN"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />


                <!-- ARROW -->

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_arrow_circle">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@null" />

                </FrameLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ADMIN                                             -->
            <!-- ID PRESERVED                                      -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/btnAdmin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_admin"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="13dp">


                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_role_icon_circle">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:contentDescription="@null" />

                </FrameLayout>


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="ADMIN"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />


                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_arrow_circle">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@null" />

                </FrameLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- STUDENT                                           -->
            <!-- ID PRESERVED                                      -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/btnStudent"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_student"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="13dp">


                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_role_icon_circle">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_grad_cap"
                        android:contentDescription="@null" />

                </FrameLayout>


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="STUDENT"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />


                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_arrow_circle">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@null" />

                </FrameLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="vertical">


                <View
                    android:layout_width="38dp"
                    android:layout_height="1dp"
                    android:background="@color/mid_blue" />


                <TextView
                    android:id="@+id/tvFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Balance. Integrity. Stewardship. Uprightness"
                    android:textColor="@color/mid_blue"
                    android:textSize="9.5sp"
                    android:letterSpacing="0.03" />

            </LinearLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>