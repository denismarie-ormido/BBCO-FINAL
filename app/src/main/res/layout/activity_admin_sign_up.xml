<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Curved header -->
            <FrameLayout
                android:id="@+id/headerCurve"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:background="@drawable/bg_header_curve_admin"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="20dp"
                    android:padding="9dp"
                    android:background="@drawable/bg_back_circle"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/white"
                    android:contentDescription="@string/back"
                    android:clickable="true"
                    android:focusable="true" />

                <FrameLayout
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_header_icon_circle">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        app:tint="@color/white"
                        android:contentDescription="@null" />
                </FrameLayout>
            </FrameLayout>

            <!-- Content -->
            <LinearLayout
                android:id="@+id/contentLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="24dp"
                android:paddingBottom="30dp"
                app:layout_constraintTop_toBottomOf="@id/headerCurve"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register Organization"
                    android:textColor="@color/dark_blue"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Create your Admin/Adviser account"
                    android:textColor="@color/text_gray"
                    android:textSize="12.5sp" />

                <!-- Full Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_blue"
                    android:paddingHorizontal="18dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/placeholder_gray"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Full Name"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="textPersonName"
                        android:autofillHints="name" />
                </LinearLayout>

                <!-- Organization Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_blue"
                    android:paddingHorizontal="18dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_building"
                        app:tint="@color/placeholder_gray"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etOrgName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Organization Name"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="text" />
                </LinearLayout>

                <!-- Description -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_pill_input_blue"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:minHeight="54dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_notes"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="What is the organization about?"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="2"
                        android:maxLines="4"
                        android:gravity="top" />
                </LinearLayout>

                <!-- Username -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_blue"
                    android:paddingHorizontal="18dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_id_card"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Username (e.g. juan.rcy)"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="text"
                        android:autofillHints="username" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="4dp"
                    android:text="Tip: combine your name and org (e.g. mreyes.rcy)"
                    android:textColor="#9BA9C2"
                    android:textSize="10.5sp" />

                <!-- Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_blue"
                    android:paddingHorizontal="18dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_mail"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Email Address"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress" />
                </LinearLayout>

                <!-- Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_blue"
                    android:paddingHorizontal="18dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Password"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="textPassword"
                        android:autofillHints="password" />

                    <ImageView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_eye"
                        android:contentDescription="@string/toggle_password"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Confirm Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_input_blue"
                    android:paddingHorizontal="18dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Confirm Password"
                        android:textColorHint="@color/placeholder_gray"
                        android:textColor="@color/dark_blue"
                        android:textSize="13.5sp"
                        android:inputType="textPassword"
                        android:autofillHints="password" />

                    <ImageView
                        android:id="@+id/btnToggleConfirmPassword"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_eye"
                        android:contentDescription="@string/toggle_password"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Upload requirement documents -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Requirement Documents"
                    android:textColor="@color/dark_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Upload your org's registration or accreditation document"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/uploadCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_upload_dashed"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="9dp"
                        android:background="@drawable/bg_qa_circle_blue"
                        android:src="@drawable/ic_upload"
                        app:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvSelectedFile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Tap to upload document (PDF, JPG, PNG)"
                        android:textColor="@color/text_gray"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Approval note -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_alert_banner"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_alert"
                        app:tint="@color/amber_text"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="Your account will be reviewed by the Super Admin before it's activated."
                        android:textColor="#7A4F0B"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Error message -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="#E53935"
                    android:textSize="12.5sp"
                    android:visibility="gone" />

                <!-- Submit -->
                <LinearLayout
                    android:id="@+id/btnSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_btn_admin"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUBMIT FOR APPROVAL"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_gravity="center_horizontal"
                    android:text="Already have an account? Login"
                    android:textColor="@color/text_gray"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>